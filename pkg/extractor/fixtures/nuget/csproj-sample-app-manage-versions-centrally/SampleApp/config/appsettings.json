{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CustomSettings": {
    "FeatureFlags": {
      "EnableAdvancedLogging": true,
      "EnableMetrics": false
    },
    "ExternalServices": {
      "ApiTimeout": 30,
      "RetryCount": 3
    }
  }
}