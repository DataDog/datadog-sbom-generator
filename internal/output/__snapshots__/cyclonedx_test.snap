{
  "$schema": "http://cyclonedx.org/schema/bom-1.5.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.5",
  "version": 1,
  "metadata": {
    "tools": {
      "components": [
        {
          "type": "application",
          "group": "datadog",
          "name": "datadog-sbom-generator",
          "version": "1.0.1"
        }
      ]
    }
  },
  "components": [
    {
      "bom-ref": "pkg:maven/org.apache.maven/maven-artifact@1.2.1",
      "type": "library",
      "name": "org.apache.maven:maven-artifact",
      "version": "1.2.1",
      "purl": "pkg:maven/org.apache.maven/maven-artifact@1.2.1",
      "properties": [
        {
          "name": "datadog-sbom-generator:exclusion",
          "value": "org.example:example-artifact1"
        },
        {
          "name": "datadog-sbom-generator:exclusion",
          "value": "org.example:*"
        },
        {
          "name": "datadog-sbom-generator:lockfile-filepath",
          "value": "path/to/my/first/pom.xml"
        },
        {
          "name": "osv-scanner:is-dev",
          "value": "true"
        }
      ]
    }
  ]
}

