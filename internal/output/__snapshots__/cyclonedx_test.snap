      "type": "library",
      "name": "mine2",
      "version": "3.2.5",
      "purl": "pkg:npm/mine2@3.2.5",
      "properties": [
        {
          "name": "datadog-sbom-generator:lockfile-filepath",
          "value": "path/to/my/second/lockfile"
        }
      ]
    },
    {
      "bom-ref": "pkg:npm/mine3@0.4.1",
      "type": "library",
      "name": "mine3",
      "version": "0.4.1",
      "purl": "pkg:npm/mine3@0.4.1",
      "properties": [
        {
          "name": "datadog-sbom-generator:lockfile-filepath",
