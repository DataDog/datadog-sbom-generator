[TestPrintCycloneDX15Results_WithDependencies/one_source_with_multiple_artifacts,_used_by_one_of_them - 1]
{
  "$schema": "http://cyclonedx.org/schema/bom-1.5.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.5",
  "version": 1,
  "metadata": {
    "tools": {
      "components": [
        {
          "type": "application",
          "group": "datadog",
          "name": "datadog-sbom-generator",
          "version": "1.0.1"
        }
      ]
    }
  },
  "components": [
    {
      "bom-ref": "pkg:maven/dev.foo/lib1@1.0-SNAPSHOT",
      "type": "library",
      "name": "dev.foo:lib1",
      "version": "1.0-SNAPSHOT",
      "purl": "pkg:maven/dev.foo/lib1@1.0-SNAPSHOT",
      "properties": [
        {
          "name": "datadog-sbom-generator:lockfile-filepath",
          "value": "pom.xml"
        }
      ]
    },
    {
      "bom-ref": "pkg:maven/dev.foo/lib2@1.0-SNAPSHOT",
      "type": "library",
      "name": "dev.foo:lib2",
      "version": "1.0-SNAPSHOT",
      "purl": "pkg:maven/dev.foo/lib2@1.0-SNAPSHOT",
      "properties": [
        {
          "name": "datadog-sbom-generator:lockfile-filepath",
          "value": "pom.xml"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "ref": "pom.xml",
      "dependsOn": [
        "lib1/pom.xml",
        "lib2/pom.xml"
      ]
    }
  ]
}

